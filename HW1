import java.awt.*;
import java.awt.event.*;
import java.util.Random;
import javax.swing.*;

public class asdfg 
{
    // 依照 PPT 的範例寫法，使用 static 宣告視窗與元件
    static JFrame frm = new JFrame("骰子模擬器");
    
    // 標籤水平置中，如 PPT 範例 JLabel("...", JLabel.CENTER) 的用法
    static JLabel lblStats = new JLabel("已擲 0 次，總和 0，平均 0.00", JLabel.CENTER);
    static JLabel lblDice = new JLabel("-", JLabel.CENTER);
    static JButton btn = new JButton("擲骰子");
    
    // 記錄次數與總和
    static int n = 0; // 已擲次數 N
    static int m = 0; // 總和 M

    public static void main(String[] args)
    {
        // 設定視窗尺寸與基本屬性
        frm.setSize(400, 320);
        frm.setLocationRelativeTo(null); // 開啟時置中[cite: 1]
        frm.setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);

        // 使用 PPT 教學的邊界版面配置 BorderLayout
        frm.setLayout(new BorderLayout());
        
        // 中央 JLabel 顯示目前點數，字體 60pt (仿照 PPT 設定 Font 的方法)[cite: 1, 2]
        lblDice.setFont(new Font("Dialog", Font.PLAIN, 60));
        
        // 根據要求，將元件放置在視窗的上方 (NORTH)、中央 (CENTER) 與下方 (SOUTH)[cite: 1, 2]
        frm.add(lblStats, BorderLayout.NORTH);
        frm.add(lblDice, BorderLayout.CENTER);
        frm.add(btn, BorderLayout.SOUTH);
        
        // 將 btn 註冊給內部類別 ActLis 當作傾聽者[cite: 2]
        btn.addActionListener(new ActLis());

        frm.setVisible(true);
    }    

    // 依照 PPT 教學，定義內部類別當成傾聽者，並實作 ActionListener 介面[cite: 2]
    static class ActLis implements ActionListener {
        public void actionPerformed(ActionEvent e) {
            // 隨機產生 1-6 的點數[cite: 1]
            Random rand = new Random();
            int point = rand.nextInt(6) + 1;
            
            // 更新數據
            n++;
            m += point;
            double avg = (double) m / n;
            
            // 更新畫面顯示文字[cite: 1]
            lblDice.setText(Integer.toString(point));
            lblStats.setText("已擲 " + n + " 次，總和 " + m + "，平均 " + String.format("%.2f", avg));
            
            // 點數為 6 時文字變綠色，為 1 時變紅色，其餘黑色[cite: 1]
            if (point == 6) {
                lblDice.setForeground(Color.GREEN);
            } else if (point == 1) {
                lblDice.setForeground(Color.RED);
            } else {
                lblDice.setForeground(Color.BLACK);
            }
        }
    }
}
